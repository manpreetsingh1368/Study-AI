HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
UPLOAD_DIR=./uploads
GEMINI_API_KEY=
# Set to a supported generateContent model available to your API account.
GEMINI_MODEL=
GEMINI_MAX_TOKENS=12000
SESSION_DAYS=30
FREE_GENERATIONS=3
PRO_GENERATIONS=30
FREE_SETS=5
PRO_SETS=200
FREE_CARDS=5
PRO_CARDS=50
MAX_PDF_BYTES=10485760
MAX_STORAGE_BYTES=52428800

MAX_PDF_PAGES=1000

DELETED_FILE_RETENTION_DAYS=30

# PDF text extraction for source-grounded notebook answers (poppler-utils)
PDFTOTEXT_BIN=pdftotext

# Public origin for reset emails, provider callbacks and share links.
# Use a real HTTPS domain in production; localhost links are development-only.
PUBLIC_BASE_URL=http://127.0.0.1:3000
PDF_VALIDATOR_HEAP_MB=384

[Unit]
Description=Study AI self-hosted API
After=network.target
[Service]
Type=simple
User=study-ai
Group=study-ai
WorkingDirectory=/opt/study-ai/server
EnvironmentFile=/etc/study-ai.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/study-ai
[Install]
WantedBy=multi-user.target
